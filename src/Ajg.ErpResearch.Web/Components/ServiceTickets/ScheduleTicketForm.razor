@using Ajg.ErpResearch.Web.Models

<EditForm @key="input"
          Model="input"
          OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <InputText
        placeholder="Technician"
        @bind-Value="input.Technician" />

    <InputDate
        Type="InputDateType.DateTimeLocal"
        @bind-Value="input.ScheduledFor" />

    <button type="submit" disabled="@IsSaving">
        @(IsSaving ? "Scheduling..." : "Schedule")
    </button>
</EditForm>

@code {
    private ScheduleTicketInput input = new();

    [Parameter]
    [EditorRequired]
    public Guid TicketId { get; set; }

    [Parameter]
    [EditorRequired]
    public EventCallback<ScheduleTicketInput> OnSubmit { get; set; }

    [Parameter]
    public bool IsSaving { get; set; }

    protected override void OnParametersSet()
    {
        input.TicketId = TicketId;
    }

    private async Task HandleValidSubmit()
    {
        await OnSubmit.InvokeAsync(input);

        input = new ScheduleTicketInput
        {
            TicketId = TicketId
        };
    }
}